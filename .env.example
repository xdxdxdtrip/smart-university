# Скопируйте в .env и при необходимости измените значения
POSTGRES_USER=smartuni
POSTGRES_PASSWORD=smartuni
POSTGRES_DB=smart_university

# Для продакшена обязательно задайте длинный случайный ключ (32+ символов)
SECRET_KEY=please-change-this-secret-key-in-env-file-32+
ACCESS_TOKEN_EXPIRE_MINUTES=120

ADMIN_EMAIL=admin@smartuni.kz
ADMIN_PASSWORD=Admin12345

# true — при старте загрузить демо-лаборатории, оборудование и пользователей
SEED_DEMO_DATA=true
