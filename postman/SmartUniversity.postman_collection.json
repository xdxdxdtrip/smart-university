{
  "info": {
    "name": "Smart University API",
    "description": "Коллекция для тестирования системы бронирования лабораторного оборудования. Запускайте папки по порядку (Collection Runner). Нужны демо-данные (SEED_DEMO_DATA=true).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Дата «завтра» в формате YYYY-MM-DD для броней",
          "const d = new Date(Date.now() + 24 * 3600 * 1000);",
          "const pad = (n) => String(n).padStart(2, '0');",
          "pm.collectionVariables.set('tomorrow', `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`);"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000"
    },
    {
      "key": "adminEmail",
      "value": "admin@smartuni.kz"
    },
    {
      "key": "adminPassword",
      "value": "Admin12345"
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "teacherToken",
      "value": ""
    },
    {
      "key": "studentToken",
      "value": ""
    },
    {
      "key": "labId",
      "value": ""
    },
    {
      "key": "equipmentId",
      "value": ""
    },
    {
      "key": "bookingId",
      "value": ""
    },
    {
      "key": "tomorrow",
      "value": ""
    }
